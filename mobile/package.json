{
  "name": "puppy-clicker-native",
  "version": "2.0.0-dev.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "node ../scripts/prepare-puppy-art.mjs",
    "start": "node ../scripts/prepare-puppy-art.mjs && expo start",
    "android": "node ../scripts/prepare-puppy-art.mjs && expo run:android",
    "export:android": "node ../scripts/prepare-puppy-art.mjs && expo export --platform android --output-dir dist",
    "apk": "node ../scripts/prepare-puppy-art.mjs && eas build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.1",
    "expo": "~57.0.17",
    "expo-constants": "57.0.22",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "2.0.0"
  }
}
